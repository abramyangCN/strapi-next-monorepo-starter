{
  "kind": "collectionType",
  "collectionName": "contacts",
  "info": {
    "singularName": "contact",
    "pluralName": "contacts",
    "displayName": "Contact",
    "description": "Contact form submissions"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "company": {
      "type": "string",
      "required": true
    },
    "jobTitle": {
      "type": "string"
    },
    "inquiryType": {
      "type": "enumeration",
      "enum": [
        "general-inquiry",
        "technical-support",
        "quotation-request",
        "partnership",
        "other"
      ],
      "required": true
    },
    "message": {
      "type": "text",
      "required": true
    }
  }
}
