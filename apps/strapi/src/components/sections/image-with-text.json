{
    "collectionName": "components_sections_image_with_texts",
    "info": {
        "displayName": "Image with Text",
        "description": "A section with image and rich text content in left-right layout"
    },
    "options": {},
    "attributes": {
        "layout": {
            "type": "enumeration",
            "enum": [
                "left",
                "right"
            ],
            "default": "left",
            "required": true
        },
        "title": {
            "type": "string"
        },
        "content": {
            "type": "customField",
            "customField": "plugin::ckeditor5.CKEditor",
            "options": {
                "preset": "defaultCkEditor"
            }
        },
        "image": {
            "type": "media",
            "multiple": false,
            "required": true,
            "allowedTypes": [
                "images"
            ]
        },
        "backgroundImage": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images"
            ]
        },
        "enableBgColor": {
            "type": "boolean",
            "default": false
        },
        "bgColor": {
            "type": "customField",
            "customField": "plugin::color-picker.color",
            "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
        }
    }
}
