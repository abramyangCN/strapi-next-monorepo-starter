{
  "collectionName": "components_sections_feature_cards",
  "info": {
    "displayName": "Feature Cards",
    "description": "A section displaying feature cards in a grid layout"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "cards": {
      "type": "component",
      "component": "utilities.feature-card",
      "repeatable": true,
      "required": true
    },
    "columnCount": {
      "type": "enumeration",
      "enum": [
        "2",
        "3",
        "4"
      ],
      "default": "3"
    },
    "enableBgColor": {
      "type": "boolean",
      "default": false
    },
    "bgColor": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
